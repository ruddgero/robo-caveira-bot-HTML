# ==========================================================
# CAVEIRA BOT CCOS — copie este arquivo para ".env" e preencha
# ==========================================================

# Senha para entrar no painel (obrigatória, mínimo 8 caracteres)
APP_SENHA=troque-esta-senha

# Porta do painel (no PC, abra http://localhost:3000)
PORT=3000

# ----------------------------------------------------------
# OPCIONAL — só preencha se for rodar no Render (nuvem).
# No PC, deixe em branco: os dados ficam na pasta "dados".
# Conteúdo JSON da chave do Firebase em UMA linha só.
# ----------------------------------------------------------
FIREBASE_CREDENTIALS=

# Valores iniciais (depois você muda tudo pela tela de Configurações)
WHATSAPP_NUMERO_ALERTA=
EMAIL_DESTINATARIOS=
