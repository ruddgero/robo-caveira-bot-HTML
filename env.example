# ==========================================================
# CAVEIRA BOT CCOS v4 — copie para ".env" (no PC) ou cadastre
# estas variáveis em Render > Environment
# ==========================================================

# Senha do ADMINISTRADOR no primeiro acesso (mín. 8 caracteres).
# Login: ADMIN_EMAIL + esta senha. Depois cada pessoa tem a sua.
APP_SENHA=troque-esta-senha
ADMIN_EMAIL=ruddgero.ribeiro@ferroport.com.br
ADMIN_NOME=Ruddgero Ribeiro

PORT=3000

# Firebase (obrigatório no Render; no PC pode ficar vazio)
FIREBASE_CREDENTIALS=

# E-mail do robô (Gmail + "senha de app" do Google)
GMAIL_USUARIO=
GMAIL_SENHA_APP=

# Quantos WhatsApps ficam ligados ao mesmo tempo (plano grátis: 2)
WHATSAPP_MAX_SESSOES=2

# Opcionais (podem ser ajustados depois na tela de Configurações)
WHATSAPP_NUMERO_ALERTA=
EMAIL_DESTINATARIOS=

# Mapa de calor (opcional): chave da conta ArcGIS para a imagem de satélite.
# Sem ela o mapa usa o serviço público da Esri (bom para testes).
ARCGIS_API_KEY=
